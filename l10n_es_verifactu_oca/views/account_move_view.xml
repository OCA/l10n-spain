<odoo>
    <record id="invoice_verifactu_form" model="ir.ui.view">
        <field name="name">account.invoice.verifactu.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_es_aeat.view_move_form" />
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button
                    type="object"
                    string="Send to Verifactu"
                    name="send_verifactu"
                    groups="l10n_es_aeat.group_account_aeat"
                    attrs="{'invisible': ['|','|',('verifactu_enabled', '=', False), ('state', 'not in', ['posted']), ('aeat_state','in',['sent','cancelled'])]}"
                />
                <button
                    type="object"
                    string="Send cancellation to Verifactu"
                    name="cancel_verifactu"
                    groups="l10n_es_aeat.group_account_aeat"
                    attrs="{'invisible': ['|','|',('verifactu_enabled', '=', False), ('state', 'not in', ['cancel']), ('aeat_state', 'not in', ['sent','sent_w_errors','sent_modified'])]}"
                />
            </button>
            <notebook position="inside">
                <page
                    string="Veri*FACTU"
                    name="page_aeat"
                    attrs="{'invisible': [('verifactu_enabled', '=', False)]}"
                >
                    <group
                        string="Veri*FACTU Information"
                        name="group_aeat_information"
                    >
                        <field name="verifactu_enabled" invisible="0" readonly="1" />
                        <field name="aeat_state" invisible="1" />
                        <field name="verifactu_description" />
                        <field
                            name="verifactu_refund_type"
                            attrs="{'required': [('verifactu_enabled', '=', True),('move_type', 'in', ('out_refund
','in_refund'))], 'invisible': [('move_type', 'not in', ('out_refund','in_refund'))]}"
                        />
                        <field
                            name="verifactu_refund_specific_invoice_type"
                            attrs="{'invisible': [('move_type', '!=', 'out_refund')]}"
                        />
                        <field
                            name="verifactu_tax_key"
                            attrs="{'required': [('verifactu_enabled', '=', True)], 'readonly': [('aeat_state', '=', 'sent')]}"
                        />
                        <field
                            name="verifactu_registration_key"
                            attrs="{'required': [('verifactu_enabled', '=', True)], 'readonly': [('aeat_state', '=', 'sent')]}"
                        />
                        <field
                            name="verifactu_hash_string"
                            readonly="1"
                            groups="base.group_no_one"
                        />
                        <field
                            name="verifactu_hash"
                            readonly="1"
                            groups="base.group_no_one"
                        />
                        <field name="verifactu_registration_date" readonly="1" />
                        <field
                            name="verifactu_previous_document_id"
                            groups="base.group_no_one"
                        />
                        <field
                            name="verifactu_next_document_id"
                            groups="base.group_no_one"
                        />
                    </group>
                    <group
                        string="Veri*FACTU Result"
                        name="group_aeat_result"
                        groups="l10n_es_aeat.group_account_aeat"
                    >
                        <notebook colspan="2">
                            <page name="page_aeat_result_general" string="General">
                                <group>
                                    <field name="aeat_state" />
                                    <field name="verifactu_csv" />
                                    <field
                                        name="aeat_send_failed"
                                        attrs="{'invisible': [('aeat_send_failed', '=', False)]}"
                                    />
                                    <field
                                        name="aeat_send_error"
                                        attrs="{'invisible': [('aeat_send_failed', '=', False)]}"
                                    />
                                </group>
                            </page>
                            <page
                                name="page_aeat_result_technical"
                                string="Technical"
                                groups="base.group_no_one"
                            >
                                <group>
                                    <label for="aeat_header_sent" />
                                </group>
                                <field name="aeat_header_sent" />
                                <group>
                                    <label for="aeat_content_sent" />
                                </group>
                                <field name="aeat_content_sent" />
                            </page>
                        </notebook>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="invoice_verifactu_search" model="ir.ui.view">
        <field name="name">account.invoice.verifactu.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <filter name="late" position="after">
                <group string="Verifactu filters">
                    <separator />
                    <filter
                        name="verifactu_not_sent"
                        string="Verifactu not sent"
                        domain="[('aeat_state', '=', 'not_sent'), ('verifactu_enabled', '=', True)]"
                        help="Never sent to Verifactu"
                    />
                    <filter
                        name="verifactu_pending"
                        string="With modifications not sent to Verifactu"
                        domain="[('aeat_state', 'in', ['sent_modified','cancelled_modified'])]"
                        help="Already sent but with local changes not sent yet"
                    />
                    <filter
                        name="verifactu_sent"
                        string="Verifactu sent"
                        domain="[('aeat_state', 'not in', ['not_sent'])]"
                        help="Already sent to Verifactu. It includes cancelled invoices"
                    />
                    <filter
                        name="aeat_send_failed"
                        string="Verifactu failed"
                        domain="[('aeat_send_failed', '=', True)]"
                        help="The last attemp to sent to Verifactu has failed"
                    />
                    <separator />
                    <filter
                        name="verifactu_cancelled"
                        string="Verifactu cancelled"
                        domain="[('aeat_state', 'in', ['cancelled','cancelled_modified'])]"
                        help="Cancelled invoices at Verifactu"
                    />
                    <separator />
                </group>
            </filter>
            <xpath expr="//group" position="inside">
                <separator />
                <filter
                    string="Verifactu error"
                    name="verifactu_error"
                    domain="[('aeat_send_failed', '=', True)]"
                    context="{'group_by':'aeat_send_error'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
