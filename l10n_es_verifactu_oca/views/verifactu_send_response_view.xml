<odoo>
    <record id="verifactu_send_response_view_tree" model="ir.ui.view">
        <field name="name">verifactu.send.response.view.tree</field>
        <field name="model">verifactu.send.response</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="verifactu_csv" />
                <field name="header" />
            </tree>
        </field>
    </record>

    <record id="verifactu_send_response_view_form" model="ir.ui.view">
        <field name="name">verifactu.send.response.view.form</field>
        <field name="model">verifactu.send.response</field>
        <field name="arch" type="xml">
            <form string="Verifactu Response">
                <sheet>
                    <h1 style="font-size: 1.9rem;">
                        <div class="row">
                            <div class="col col-md-8">
                                <label for="name" string="Name" />
                                <div>
                                    <field name="name" style="width:80% !important;" />
                                </div>
                            </div>
                        </div>
                    </h1>
                    <h2 style="font-size: 1.5rem;">
                        <label for="datetime" string="Date" />
                        <div>
                            <field name="datetime" style="width:80% !important;" />
                        </div>
                    </h2>
                    <notebook>
                        <page string="Details">
                            <group>
                                <group name="verifactu1">
                                    <field name="response" readonly="1" />
                                    <field name="header" readonly="1" />
                                    <field name="invoice_data" readonly="1" />
                                </group>
                                <group name="verifactu2">
                                    <div class="o_row" name="recruitment_target">
                                        <span>Other details</span>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Verifactu" name="name">
                            <field name="name" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field
                        name="name"
                        groups="base.group_user"
                        options="{'post_refresh': 'recipients'}"
                    />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="verifactu_send_response_view_kanban" model="ir.ui.view">
        <field name="name">verifactu.send.response.view.kanban</field>
        <field name="model">verifactu.send.response</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_activity">
                    <field name="name" />
                    <field name="datetime" />
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="row">
                                    <div class="col-6 o_kanban_record_headings">
                                        <strong>
                                            <span>
                                                <field name="name" />
                                            </span>
                                        </strong>
                                    </div>
                                    <div class="col-6 text-end">
                                        <strong><i
                                            class="fa fa-clock-o"
                                            aria-label="Date"
                                            role="img"
                                            title="Date"
                                        /> <t t-esc="record.datetime.value" /></strong>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <span><field name="activity_type_id" /></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
        </field>
    </record>

    <record id="verifactu_send_response_view_search" model="ir.ui.view">
        <field name="name">verifactu.send.response.view.search</field>
        <field name="model">verifactu.send.response</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <group expand="0" string="Group By">
                    <filter
                        string="Activity Type"
                        name="name"
                        context="{'group_by':'activity_type_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>
