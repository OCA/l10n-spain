<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_verifactu_chain_tree" model="ir.ui.view">
        <field name="name">verifactu.chain.tree</field>
        <field name="model">verifactu.chain</field>
        <field name="arch" type="xml">
            <tree>
                <field name="document_id" />
                <field name="company_id" />
                <field name="document_hash" />
                <field name="create_date" />
            </tree>
        </field>
    </record>

    <record id="view_verifactu_chain_form" model="ir.ui.view">
        <field name="name">verifactu.chain.form</field>
        <field name="model">verifactu.chain</field>
        <field name="arch" type="xml">
            <form string="VeriFactu Chain Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="document_id" />
                            <field name="company_id" />
                        </group>
                        <group>
                            <field name="previous_chain_entry_id" />
                            <field name="document_hash" />
                            <field name="create_date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_verifactu_chain_search" model="ir.ui.view">
        <field name="name">verifactu.chain.search</field>
        <field name="model">verifactu.chain</field>
        <field name="arch" type="xml">
            <search string="Search VeriFactu Chain">
                <field name="document_id" />
                <field name="company_id" />
                <field name="document_hash" />
                <filter
                    string="Company"
                    name="group_by_company"
                    domain="[]"
                    context="{'group_by': 'company_id'}"
                />
                <filter
                    string="Date"
                    name="group_by_date"
                    domain="[]"
                    context="{'group_by': 'create_date:month'}"
                />
            </search>
        </field>
    </record>

    <record id="action_verifactu_chain" model="ir.actions.act_window">
        <field name="name">VeriFactu Chain</field>
        <field name="res_model">verifactu.chain</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No VeriFactu chain entries found!
            </p>
            <p>
                Chain entries are automatically created when invoices are validated
                with VeriFactu enabled.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_verifactu_chain"
        name="Aeat Verifactu Chain"
        parent="l10n_es_aeat.menu_l10n_es_aeat_config"
        action="action_verifactu_chain"
        sequence="50"
    />
</odoo>
