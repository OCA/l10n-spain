<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_template_form_inherit_canon_category" model="ir.ui.view">
        <field name="name">product.template.form.inherit.canon.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field
                    name="l10n_es_digital_canon"
                    invisible="product_variant_count > 1 and not is_product_variant"
                />
            </field>
        </field>
    </record>
</odoo>
