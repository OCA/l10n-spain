<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_position_form_atc_art25" model="ir.ui.view">
        <field name="name">account.fiscal.position.form.inherit.atc.art25</field>
        <field name="model">account.fiscal.position</field>
        <field
            name="inherit_id"
            ref="l10n_es_aeat_sii_oca.view_account_position_form"
        />
        <field name="arch" type="xml">
            <field name="sii_exempt_cause" position="after">
                <field
                    name="sii_art25_tipo_bien"
                    invisible="sii_exempt_cause != 'E5' or not aeat_active"
                />
            </field>
        </field>
    </record>
</odoo>
