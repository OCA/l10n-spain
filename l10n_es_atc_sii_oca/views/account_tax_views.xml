<odoo>
    <record id="view_tax_form" model="ir.ui.view">
        <field name="name">account.tax.form.atc.sii</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="l10n_es.account_tax_form_inherit_l10n_es_edi" />
        <field name="arch" type="xml">
            <field name="l10n_es_applicability" position="after">
                <field name="l10n_es_atc_aiem" invisible="country_code != 'ES'" />
            </field>
        </field>
    </record>
</odoo>
