<odoo>
    <record id="invoice_atc_sii_form" model="ir.ui.view">
        <field name="name">account.move.form.atc.sii</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_es_aeat_sii_oca.invoice_sii_form" />
        <field name="arch" type="xml">
            <group name="group_sii_information" position="after">
                <group
                    string="Art. 25 Law 19/1994"
                    name="group_sii_art25"
                    invisible="not sii_art25_required"
                >
                    <field
                        name="sii_art25_detail_ids"
                        nolabel="1"
                        colspan="2"
                        readonly="state == 'posted'"
                    >
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="asset_type" />
                            <field name="advance_payment" />
                            <field name="document_type" required="asset_type == '01'" />
                            <field
                                name="protocol_number"
                                required="asset_type == '01' and document_type == '01'"
                            />
                            <field
                                name="notary_name"
                                required="asset_type == '01' and document_type == '01'"
                            />
                        </list>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>
