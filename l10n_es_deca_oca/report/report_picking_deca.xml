<odoo>
    <template id="report_deca_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)" />
                    <div class="page">
                        <div class="text-center">
                            <h2
                            >Document for electronic Control of Administration (DeCA)</h2>
                            <p
                            >This carriage is governed by Law 15/2009 of 11 November, on the contract for the land carriage of goods, and by any other applicable Spanish legislation.</p>
                        </div>

                        <div class="mb-4">
                            <strong class="fw-bold">Place and date of issue:</strong>
                            <span t-out="o.company_id.city" />, <span
                            t-out="o.create_date"
                            t-options='{"widget": "datetime", "format": "dd/MM/yyyy"}'
                        />
                        </div>

                        <div class="row mt-4">
                            <!-- Sender info -->
                            <div class="col-6">
                                <strong
                                    class="fw-bold"
                                >Sender / Place of loading:</strong>
                                <t
                                    t-set="deca_sender"
                                    t-value="o.picking_type_id.warehouse_id.partner_id or o.company_id.partner_id"
                                />
                                <t t-set="deca_consignee" t-value="o.partner_id" />
                                <t t-if="o.picking_type_id.code == 'incoming'">
                                    <t t-set="deca_sender" t-value="o.partner_id" />
                                    <t
                                        t-set="deca_consignee"
                                        t-value="o.picking_type_id.warehouse_id.partner_id or o.company_id.partner_id"
                                    />
                                </t>

                                <div t-if="deca_sender">
                                    <span t-field="deca_sender.name" /><br />
                                    <span>NIF: </span><span
                                    t-field="deca_sender.vat"
                                /><br />
                                    <span t-field="deca_sender.street" /><br />
                                    <span t-field="deca_sender.zip" /> <span
                                    t-field="deca_sender.city"
                                />, <span t-field="deca_sender.state_id.name" />
                                </div>
                            </div>

                            <!-- Delivery Info -->
                            <div class="col-6">
                                <strong
                                    class="fw-bold"
                                >Consignee / Place of delivery:</strong>
                                <div t-if="deca_consignee">
                                    <span t-field="deca_consignee.name" /><br />
                                    <span>NIF: </span><span
                                    t-field="deca_consignee.vat"
                                /><br />
                                    <span t-field="deca_consignee.street" /><br />
                                    <span t-field="deca_consignee.zip" /> <span
                                    t-field="deca_consignee.city"
                                />, <span t-field="deca_consignee.state_id.name" />
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <!-- Carrier Info -->
                            <div class="col-6">
                                <strong class="fw-bold">Carrier:</strong>
                                <t
                                    t-set="carrier_contact"
                                    t-value="o.carrier_contact_id"
                                />
                                <div t-if="carrier_contact">
                                    <span t-out="carrier_contact.name" /><br />
                                    <span>NIF: </span><span
                                    t-out="carrier_contact.vat"
                                /><br />
                                    <span t-out="carrier_contact.street" /><br />
                                    <span t-out="carrier_contact.zip" /> <span
                                    t-out="carrier_contact.city"
                                />, <span
                                    t-out="carrier_contact.state_id.name"
                                />, <span t-out="carrier_contact.country_id.name" />
                                </div>
                            </div>

                            <!-- DeCA Info -->
                            <div class="col-6">
                                <strong class="fw-bold">Date of loading:</strong>
                                <span
                                    t-out="o.date_done or o.scheduled_date"
                                    t-options='{"widget": "datetime", "format": "dd/MM/yyyy"}'
                                />
                                <br />

                                <strong
                                    class="mt-2 d-block"
                                    t-if="o.tractor_license_plate or o.tractor_license_plate_history"
                                >Tractor licence plate:</strong>
                                <div>
                                    <t t-if="o.tractor_license_plate_history">
                                        <t
                                            t-foreach="o.tractor_license_plate_history.splitlines()"
                                            t-as="old_plate"
                                        >
                                            <div>
                                                <s>
                                                    <t t-out="old_plate" />
                                                </s>
                                            </div>
                                        </t>
                                    </t>
                                    <div t-if="o.tractor_license_plate">
                                        <t t-out="o.tractor_license_plate" />
                                    </div>
                                </div>

                                <strong
                                    class="mt-2 d-block"
                                    t-if="o.trailer_license_plate or o.trailer_license_plate_history"
                                >Trailer licence plate:</strong>
                                <div>
                                    <t t-if="o.trailer_license_plate_history">
                                        <t
                                            t-foreach="o.trailer_license_plate_history.splitlines()"
                                            t-as="old_plate"
                                        >
                                            <div>
                                                <s>
                                                    <t t-out="old_plate" />
                                                </s>
                                            </div>
                                        </t>
                                    </t>
                                    <div t-if="o.trailer_license_plate">
                                        <t t-out="o.trailer_license_plate" />
                                    </div>
                                </div>

                                <strong
                                    class="mt-2 d-block"
                                    t-if="o.special_authorization or o.special_authorization_history"
                                >Special Authorizations:</strong>
                                <div>
                                    <t t-if="o.special_authorization_history">
                                        <t
                                            t-foreach="o.special_authorization_history.splitlines()"
                                            t-as="old_auth"
                                        >
                                            <div>
                                                <s>
                                                    <t t-out="old_auth" />
                                                </s>
                                            </div>
                                        </t>
                                    </t>
                                    <div t-if="o.special_authorization">
                                        <t t-out="o.special_authorization" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Products Table -->
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Unit</th>
                                    <th class="text-end">Weight</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.move_ids" t-as="move">
                                    <tr>
                                        <td>
                                            <span
                                                t-field="move.product_id.display_name"
                                            />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="move.quantity" />
                                        </td>
                                        <td>
                                            <span t-field="move.product_uom.name" />
                                        </td>
                                        <td class="text-end"><span
                                            t-field="move.deca_weight"
                                        /> kg</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- QR Code -->
                        <div class="text-center mt-4">
                            <div
                                t-out="o._get_share_url()"
                                t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 150, 'height': 150}"
                            />
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_deca">
        <t t-call="l10n_es_deca_oca.report_deca_document">
            <t t-set="docs" t-value="docs" />
        </t>
    </template>
</odoo>
