<odoo>
    <template id="report_deca_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-set="o"
                    t-value="o.with_company(o.company_id).with_context(lang=o.partner_id.lang or o.company_id.partner_id.lang or 'en_US', tz=o.company_id.partner_id.tz or 'UTC')"
                />
                <t t-set="deca" t-value="o._get_deca_report_data()" />
                <t t-set="company" t-value="o.company_id" />
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center">
                            <h2
                            >Document for electronic Control of Administration (DeCA)</h2>
                            <p
                            >This carriage is governed by Law 15/2009 of 11 November, on the contract for the land carriage of goods, and by any other applicable Spanish legislation.</p>
                        </div>

                        <div class="mb-4">
                            <strong class="fw-bold">Place and date of issue:</strong>
                            <span t-out="deca['issue_city']" />, <span
                            t-out="deca['issue_date']"
                        />
                        </div>

                        <div class="row mt-4">
                            <!-- Sender info -->
                            <div class="col-6">
                                <strong
                                    class="fw-bold"
                                >Sender / Place of loading:</strong>
                                <t t-set="deca_sender" t-value="deca['sender']" />
                                <t t-set="deca_consignee" t-value="deca['consignee']" />

                                <div t-if="deca_sender">
                                    <span t-out="deca_sender['name']" /><br />
                                    <span>NIF: </span><span
                                    t-out="deca_sender['vat']"
                                /><br />
                                    <span t-out="deca_sender['street']" /><br />
                                    <span t-out="deca_sender['zip']" /> <span
                                    t-out="deca_sender['city']"
                                />, <span t-out="deca_sender['state']" />
                                </div>
                            </div>

                            <!-- Delivery Info -->
                            <div class="col-6">
                                <strong
                                    class="fw-bold"
                                >Consignee / Place of delivery:</strong>
                                <div t-if="deca_consignee">
                                    <span t-out="deca_consignee['name']" /><br />
                                    <span>NIF: </span><span
                                    t-out="deca_consignee['vat']"
                                /><br />
                                    <span t-out="deca_consignee['street']" /><br />
                                    <span t-out="deca_consignee['zip']" /> <span
                                    t-out="deca_consignee['city']"
                                />, <span t-out="deca_consignee['state']" />
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <!-- Carrier Info -->
                            <div class="col-6">
                                <strong class="fw-bold">Carrier:</strong>
                                <t t-set="carrier_contact" t-value="deca['carrier']" />
                                <div t-if="carrier_contact">
                                    <span t-out="carrier_contact['name']" /><br />
                                    <span>NIF: </span><span
                                    t-out="carrier_contact['vat']"
                                /><br />
                                    <span t-out="carrier_contact['street']" /><br />
                                    <span t-out="carrier_contact['zip']" /> <span
                                    t-out="carrier_contact['city']"
                                />, <span t-out="carrier_contact['state']" />, <span
                                    t-out="carrier_contact['country']"
                                />
                                </div>
                            </div>

                            <!-- DeCA Info -->
                            <div class="col-6">
                                <strong class="fw-bold">Date of loading:</strong>
                                <span t-out="deca['loading_date']" />
                                <br />

                                <strong
                                    class="mt-2 d-block"
                                    t-if="deca['tractor_license_plate'] or deca['tractor_license_plate_history']"
                                >Tractor licence plate:</strong>
                                <div>
                                    <t t-if="deca['tractor_license_plate_history']">
                                        <t
                                            t-foreach="deca['tractor_license_plate_history']"
                                            t-as="old_plate"
                                        >
                                            <div>
                                                <s>
                                                    <t t-out="old_plate" />
                                                </s>
                                            </div>
                                        </t>
                                    </t>
                                    <div t-if="deca['tractor_license_plate']">
                                        <t t-out="deca['tractor_license_plate']" />
                                    </div>
                                </div>

                                <strong
                                    class="mt-2 d-block"
                                    t-if="deca['trailer_license_plate'] or deca['trailer_license_plate_history']"
                                >Trailer licence plate:</strong>
                                <div>
                                    <t t-if="deca['trailer_license_plate_history']">
                                        <t
                                            t-foreach="deca['trailer_license_plate_history']"
                                            t-as="old_plate"
                                        >
                                            <div>
                                                <s>
                                                    <t t-out="old_plate" />
                                                </s>
                                            </div>
                                        </t>
                                    </t>
                                    <div t-if="deca['trailer_license_plate']">
                                        <t t-out="deca['trailer_license_plate']" />
                                    </div>
                                </div>

                                <strong
                                    class="mt-2 d-block"
                                    t-if="deca['special_authorization'] or deca['special_authorization_history']"
                                >Special Authorizations:</strong>
                                <div>
                                    <t t-if="deca['special_authorization_history']">
                                        <t
                                            t-foreach="deca['special_authorization_history']"
                                            t-as="old_auth"
                                        >
                                            <div>
                                                <s>
                                                    <t t-out="old_auth" />
                                                </s>
                                            </div>
                                        </t>
                                    </t>
                                    <div t-if="deca['special_authorization']">
                                        <t t-out="deca['special_authorization']" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Products Table -->
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Unit</th>
                                    <th class="text-end">Weight</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="deca['goods']" t-as="move">
                                    <tr>
                                        <td>
                                            <span t-out="move['product']" />
                                        </td>
                                        <td class="text-end">
                                            <span t-out="move['quantity']" />
                                        </td>
                                        <td>
                                            <span t-out="move['unit']" />
                                        </td>
                                        <td class="text-end"><span
                                            t-out="move['weight']"
                                        /> kg</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- QR Code -->
                        <div class="text-center mt-4">
                            <div
                                t-out="deca['share_url']"
                                t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 150, 'height': 150}"
                            />
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_deca">
        <t t-call="l10n_es_deca_oca.report_deca_document">
            <t t-set="docs" t-value="docs" />
        </t>
    </template>
</odoo>
