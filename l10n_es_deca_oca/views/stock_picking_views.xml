<odoo>
    <record id="view_picking_form_inherit_l10n_es_deca_oca" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit.l10n_es_deca_oca</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(l10n_es_deca_oca.action_report_deca)d"
                    string="Print DeCA"
                    type="action"
                    groups="stock.group_stock_user"
                    invisible="not l10n_es_show_deca"
                />
                <button
                    name="action_get_share_url"
                    string="Share DeCA"
                    type="object"
                    groups="stock.group_stock_user"
                    invisible="not l10n_es_show_deca"
                    help="Open the bearer link to the current PDF. Anyone with this link can download it."
                    confirm="Anyone with this link can download the DeCA. Printing or opening a valid link generates a new version when printed data changes."
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="DeCA" name="deca_info" invisible="not l10n_es_show_deca">
                    <div class="alert alert-info" role="alert">
                        Printing or opening a valid share link generates the current DeCA.
                        Changed printed data creates a new version; previous files remain attached.
                        Anyone with the share link can download the current document.
                    </div>
                    <group>
                        <group>
                            <field name="l10n_es_show_deca" invisible="1" />
                            <field name="tractor_license_plate" />
                            <field name="trailer_license_plate" />
                            <field name="deca_weight" />
                            <field name="deca_version" />
                        </group>
                        <group>
                            <field name="special_authorization" widget="text" />
                            <field
                                name="carrier_contact_id"
                                readonly="state == 'cancel'"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
