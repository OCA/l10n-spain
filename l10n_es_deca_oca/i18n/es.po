#. module: l10n_es_deca_oca
#: model_terms:ir.ui.view,arch_db:l10n_es_deca_oca.view_picking_form_inherit_l10n_es_deca_oca
msgid ""
"Anyone with this link can download the DeCA. Printing or opening a valid "
"link generates a new version when printed data changes."
msgstr ""
"Cualquier persona con este enlace puede descargar el DeCA. Al imprimir o "
"abrir un enlace válido se genera una nueva versión cuando cambian los "
"datos impresos."

#. module: l10n_es_deca_oca
#: model_terms:ir.ui.view,arch_db:l10n_es_deca_oca.view_picking_form_inherit_l10n_es_deca_oca
msgid ""
"Open the bearer link to the current PDF. Anyone with this link can "
"download it."
msgstr ""
"Abre el enlace al portador del PDF actual. Cualquier persona con este "
"enlace puede descargarlo."

#. module: l10n_es_deca_oca
#: model_terms:ir.ui.view,arch_db:l10n_es_deca_oca.view_picking_form_inherit_l10n_es_deca_oca
msgid "Print DeCA"
msgstr "Imprimir DeCA"

#. module: l10n_es_deca_oca
#: model_terms:ir.ui.view,arch_db:l10n_es_deca_oca.view_picking_form_inherit_l10n_es_deca_oca
msgid ""
"Printing or opening a valid share link generates the current DeCA.\n"
"                        Changed printed data creates a new version; previous files remain attached.\n"
"                        Anyone with the share link can download the current document."
msgstr ""
"Al imprimir o abrir un enlace para compartir válido se genera el DeCA actual.\n"
"                        Si cambian los datos impresos se crea una nueva versión; los archivos anteriores permanecen adjuntos.\n"
"                        Cualquier persona con el enlace para compartir puede descargar el documento actual."

#. module: l10n_es_deca_oca
#: model_terms:ir.ui.view,arch_db:l10n_es_deca_oca.view_picking_form_inherit_l10n_es_deca_oca
msgid "Share DeCA"
msgstr "Compartir DeCA"
