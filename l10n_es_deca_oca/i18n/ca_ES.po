msgstr "Origen no vàlid del fitxer DeCA generat."

#. module: l10n_es_deca_oca
#. odoo-python
#: code:addons/l10n_es_deca_oca/models/ir_attachment.py:0
msgid "Issued DeCA files cannot be changed."
msgstr "Els fitxers DeCA emesos no es poden modificar."

#. module: l10n_es_deca_oca
#. odoo-python
#: code:addons/l10n_es_deca_oca/models/ir_attachment.py:0
msgid "Issued DeCA files cannot be deleted while their transfer exists."
msgstr ""
"Els fitxers DeCA emesos no es poden eliminar mentre existeixi la seva "
"transferència."

#. module: l10n_es_deca_oca
#. odoo-python
#: code:addons/l10n_es_deca_oca/models/ir_attachment.py:0
msgid "Only DeCA generation can set file provenance."
msgstr "Només la generació del DeCA pot establir l'origen del fitxer."

#. module: l10n_es_deca_oca
#. odoo-python
#: code:addons/l10n_es_deca_oca/models/stock_move.py:0
msgid ""
"The effective product weight unit is invalid. Configure an existing weight"
" unit before generating a DeCA."
msgstr ""
"La unitat de pes efectiva de producte no és vàlida. Configureu una unitat "
"de pes existent abans de generar un DeCA."

#. module: l10n_es_deca_oca
#. odoo-python
#: code:addons/l10n_es_deca_oca/models/stock_picking.py:0
msgid ""
"A positive DeCA weight is too small to display in kg with six decimal "
"places. Review the cargo before generating the document."
msgstr ""
"Un pes positiu del DeCA és massa petit per mostrar-se en kg amb sis "
"decimals. Reviseu la càrrega abans de generar el document."

