#. module: l10n_es_deca_oca
#: model_terms:ir.ui.view,arch_db:l10n_es_deca_oca.view_picking_form_inherit_l10n_es_deca_oca
msgid ""
"Anyone with this link can download the DeCA. Printing or opening a valid "
"link generates a new version when printed data changes."
msgstr ""
"Qualsevol persona amb aquest enllaç pot descarregar el DeCA. En imprimir o"
" obrir un enllaç vàlid es genera una nova versió quan canvien les dades "
"impreses."

#. module: l10n_es_deca_oca
#: model_terms:ir.ui.view,arch_db:l10n_es_deca_oca.view_picking_form_inherit_l10n_es_deca_oca
msgid ""
"Open the bearer link to the current PDF. Anyone with this link can "
"download it."
msgstr ""
"Obre l'enllaç al portador del PDF actual. Qualsevol persona amb aquest "
"enllaç pot descarregar-lo."

#. module: l10n_es_deca_oca
#: model_terms:ir.ui.view,arch_db:l10n_es_deca_oca.view_picking_form_inherit_l10n_es_deca_oca
msgid "Print DeCA"
