#. module: l10n_es_deca_oca
#. odoo-python
#: code:addons/l10n_es_deca_oca/models/ir_attachment.py:0
msgid "DeCA file provenance can only be set on generation."
msgstr "L'origen del fitxer DeCA només es pot establir en generar-lo."

#. module: l10n_es_deca_oca
#. odoo-python
#: code:addons/l10n_es_deca_oca/models/ir_attachment.py:0
