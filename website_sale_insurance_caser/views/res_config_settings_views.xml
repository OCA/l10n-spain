<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.caser.insurance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='cart_redirect_setting']" position="before">
                <setting
                    id="caser_insurance_setting"
                    string="Caser Insurance"
                    help="Show Caser insurance options on product pages and at checkout."
                >
                    <field name="website_sale_caser_insurance_enabled" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
