<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="OrderReceipt"
        t-inherit="point_of_sale.OrderReceipt"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[hasclass('pos-receipt')]/t[1]" position="before">
            <t t-if="receipt.verifactu_qr">
                <div class="pos-receipt-center-align">
                    <span>QR Tributario:</span>
                    <img
                        t-att-src="'/report/barcode/QR/' + receipt.verifactu_qr + '?width=150&amp;height=150'"
                        class="pos-receipt-qrcode verifactu-qr"
                    />
                    <span>VERI*FACTU</span>
                </div>
                <br />
            </t>
        </xpath>
    </t>
</templates>
