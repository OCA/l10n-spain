<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_verifactu_invoice_entry_list_pos" model="ir.ui.view">
        <field name="name">verifactu.invoice.entry.list.pos</field>
        <field name="model">verifactu.invoice.entry</field>
        <field name="arch" type="xml">
            <list string="Veri*FACTU Entries">
                <field name="document_name" />
                <field name="document_hash" />
                <field name="send_state" />
                <field name="entry_type" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="view_verifactu_response_line_list_pos" model="ir.ui.view">
        <field name="name">verifactu.invoice.entry.response.line.list.pos</field>
        <field name="model">verifactu.invoice.entry.response.line</field>
        <field name="arch" type="xml">
            <list string="Veri*FACTU Responses">
                <field name="document_id" />
                <field name="send_state" />
                <field name="error_code" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="view_pos_order_verifactu_form" model="ir.ui.view">
        <field name="name">pos.order.verifactu.form</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <button name="refund" position="after">
                <button
                    type="object"
                    string="Re-send to Verifactu"
                    name="resend_verifactu"
                    groups="l10n_es_aeat.group_account_aeat"
                    invisible="(not verifactu_enabled) or (state not in ['paid', 'done']) or (aeat_state != 'sent_w_errors')"
                />
                <button
                    type="object"
                    string="Generate VERI*FACTU chaining"
                    name="action_recover_verifactu_chaining"
                    groups="l10n_es_aeat.group_account_aeat"
                    invisible="(not verifactu_enabled) or (state not in ['paid', 'done']) or to_invoice or last_verifactu_invoice_entry_id"
                />
            </button>
            <notebook position="inside">
                <page
                    string="Veri*FACTU"
                    name="page_aeat"
                    invisible="not verifactu_enabled"
                >
                    <group
                        string="Veri*FACTU Information"
                        name="group_aeat_information"
                    >
                        <field name="verifactu_enabled" invisible="0" readonly="1" />
                        <field name="aeat_state" invisible="1" />
                        <field name="to_invoice" invisible="1" />
                        <field
                            name="last_verifactu_invoice_entry_id"
                            invisible="0"
                            readonly="1"
                        />
                        <field name="verifactu_description" />
                        <field name="verifactu_tax_key" />
                        <field
                            name="verifactu_registration_key"
                            required="verifactu_enabled"
                        />
                        <field name="verifactu_hash_string" readonly="1" />
                        <field name="verifactu_hash" readonly="1" />
                        <field name="verifactu_registration_date" readonly="1" />
                        <field
                            name="verifactu_chaining_attempts"
                            invisible="not verifactu_chaining_attempts"
                        />
                    </group>
                    <group string="VeriFactu History" name="group_aeat_history">
                        <field
                            name="verifactu_invoice_entry_ids"
                            readonly="1"
                            nolabel="1"
                            colspan="2"
                            domain="[('model','=','pos.order')]"
                            context="{
                         'default_model': 'pos.order',
                         'list_view_ref': 'l10n_es_verifactu_pos_oca.view_verifactu_invoice_entry_list_pos'
                       }"
                        />

                        <field
                            name="verifactu_response_line_ids"
                            readonly="1"
                            nolabel="1"
                            colspan="2"
                            domain="[('model','=','pos.order')]"
                            context="{
                         'default_model': 'pos.order',
                         'list_view_ref': 'l10n_es_verifactu_pos_oca.view_verifactu_response_line_list_pos'
                       }"
                        />
                    </group>
                    <group
                        string="Veri*FACTU Result"
                        name="group_aeat_result"
                        groups="l10n_es_aeat.group_account_aeat"
                    >
                        <group>
                            <field
                                name="last_verifactu_response_line_id"
                                readonly="1"
                            />
                            <field name="verifactu_csv" readonly="1" />
                            <field
                                name="aeat_send_failed"
                                invisible="not aeat_send_failed"
                            />
                            <field
                                name="aeat_send_error"
                                invisible="not aeat_send_failed"
                            />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_pos_order_verifactu_search" model="ir.ui.view">
        <field name="name">pos.order.verifactu.search</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter" />
        <field name="arch" type="xml">
            <filter name="order_date" position="after">
                <separator />
                <filter
                    name="aeat_send_failed"
                    string="VERI*FACTU failed"
                    domain="[('aeat_send_failed', '=', True)]"
                    help="The last attempt to chain or send to VERI*FACTU has failed"
                />
            </filter>
            <filter name="order_month" position="after">
                <filter
                    string="VERI*FACTU error"
                    name="verifactu_error"
                    domain="[('aeat_send_failed', '=', True)]"
                    context="{'group_by': 'aeat_send_error'}"
                />
            </filter>
        </field>
    </record>
</odoo>
