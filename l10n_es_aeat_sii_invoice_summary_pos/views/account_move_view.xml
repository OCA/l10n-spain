<odoo>
    <record id="invoice_sii_move_summary_form_view_inherit" model="ir.ui.view">
        <field name="name">account.move.sii.invoice.summary.form.view.inherit</field>
        <field name="model">account.move</field>
        <field
            name="inherit_id"
            ref="l10n_es_aeat_sii_invoice_summary.invoice_sii_move_summary_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_pos_order_summary"
                    class="oe_stat_button"
                    icon="fa-bars"
                    type="object"
                    invisible="not is_invoice_summary"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Order Summary SII</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='is_invoice_summary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='sii_invoice_summary_start']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath
                expr="//field[@name='sii_invoice_summary_end']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>

            <xpath expr="//group[@name='group_sii_information']" position="attributes">
                <attribute name="string" remove="" />
            </xpath>
            <xpath expr="//group[@name='group_sii_information']" position="before">
                <group string="SII Information">
                    <field
                        name="is_invoice_summary"
                        invisible="move_type not in ('out_invoice','out_refund')"
                        readonly="state != 'draft'"
                    />
                    <field
                        name="sii_start_date"
                        invisible="move_type not in ('out_invoice','out_refund') or not is_invoice_summary"
                        readonly="state != 'draft'"
                    />
                    <field
                        name="sii_end_date"
                        invisible="move_type not in ('out_invoice','out_refund') or not is_invoice_summary"
                        readonly="state != 'draft'"
                    />
                    <field
                        name="sii_invoice_summary_start"
                        string="First Invoice"
                        invisible="move_type not in ('out_invoice','out_refund') or not is_invoice_summary"
                        required="is_invoice_summary and (not sii_start_date or not sii_end_date)"
                        readonly="state != 'draft'"
                    />
                    <field
                        name="sii_invoice_summary_end"
                        string="Last Invoice"
                        invisible="move_type not in ('out_invoice','out_refund') or not is_invoice_summary"
                        required="is_invoice_summary and (not sii_start_date or not sii_end_date)"
                        readonly="state != 'draft'"
                    />
                </group>
                <button
                    name="populate_invoice_summary_by_dates"
                    type="object"
                    string="Summary by dates"
                    invisible="move_type not in ('out_invoice','out_refund') or not is_invoice_summary or state != 'draft'"
                    class="btn btn-primary"
                />
            </xpath>
        </field>
    </record>
</odoo>
