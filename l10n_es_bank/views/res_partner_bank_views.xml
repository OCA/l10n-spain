<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_bank_form_l10n_es_bank" model="ir.ui.view">
        <field name="name">res.partner.bank.form.l10n.es.bank</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="arch" type="xml">
            <field name="bank_bic" position="after">
                <field name="l10n_es_bank_code" />
            </field>
        </field>
    </record>
    <record id="view_partner_bank_list_l10n_es_bank" model="ir.ui.view">
        <field name="name">res.partner.bank.list.l10n.es.bank</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_tree" />
        <field name="arch" type="xml">
            <field name="bank_bic" position="after">
                <field name="l10n_es_bank_code" optional="hide" />
            </field>
        </field>
    </record>
    <record id="view_partner_bank_search_l10n_es_bank" model="ir.ui.view">
        <field name="name">res.partner.bank.search.l10n.es.bank</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="l10n_es_bank_code" />
                <filter string="Group By">
                    <filter
                        name="group_by_l10n_es_bank_code"
                        string="Bank Code"
                        context="{'group_by': 'l10n_es_bank_code'}"
                    />
                </filter>
            </xpath>
        </field>
    </record>
</odoo>
