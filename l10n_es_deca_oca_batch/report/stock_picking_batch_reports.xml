<odoo>
    <record id="action_report_deca_batch" model="ir.actions.report">
        <field name="name">DeCA</field>
        <field name="model">stock.picking.batch</field>
        <field name="domain" eval="[('picking_type_id.code', '=', 'outgoing')]" />
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_es_deca_oca_batch.report_deca_batch</field>
        <field name="print_report_name">'DeCA - %s' % (object.name)</field>
    </record>
</odoo>
