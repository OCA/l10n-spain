<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_pos_seq_device" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="l10n_es_pos_simp_seq" position="attributes">
                <attribute name="invisible">pos_sequence_by_device</attribute>
            </setting>
            <xpath expr="//block[@id='pos_accounting_section']" position="after">
                <block title="Sequencing" id="pos_sequencing_section">
                    <setting id="pos_seq_by_device">
                        <field name="pos_sequence_by_device" />
                        <label
                            string="Sequencing by physical device"
                            for="pos_sequence_by_device"
                        />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            aria-label="Values set here are company-specific."
                            groups="base.group_multi_company"
                            role="img"
                        />
                        <div class="text-muted">
                            Use a different subsequence for each physical device on POS.
                        </div>
                    </setting>
                    <setting
                        id="physical_pos_devices"
                        invisible="not pos_sequence_by_device"
                    >
                        <label for="pos_device_ids" string="POS Physical devices" />
                        <div class="text-muted">
                            Select available physical devices for this POS configuration
                        </div>
                        <div class="content-group mt16">
                            <field name="pos_device_ids" widget="many2many_tags" />
                        </div>
                        <div>
                            <button
                                name="%(pos_devices_act_window)d"
                                icon="oi-arrow-right"
                                type="action"
                                string="POS Physical devices"
                                class="btn-link"
                            />
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
