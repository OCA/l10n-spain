<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref'][last()]" position="after">
                <field name="thirdparty_invoice" invisible="1" />
                <field
                    name="thirdparty_number"
                    invisible="1"
                    readonly="state != 'draft'"
                />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']//tree/field[@name='name']"
                position="after"
            >
                <field
                    name='l10n_es_aeat_real_estate_id'
                    optional='hide'
                    context="{'default_partner_id': partner_id}"
                    groups="l10n_es_aeat.group_use_aeat_real_estates"
                    column_invisible="parent.country_code != 'ES'"
                />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']//form/sheet//field[@name='name']"
                position="after"
            >
                <label
                    for="l10n_es_aeat_real_estate_id"
                    string="Real Estate"
                    groups="l10n_es_aeat.group_use_aeat_real_estates"
                    invisible="parent.country_code != 'ES'"
                />
                <field
                    name='l10n_es_aeat_real_estate_id'
                    context="{'default_partner_id': partner_id}"
                    groups="l10n_es_aeat.group_use_aeat_real_estates"
                    invisible="parent.country_code != 'ES'"
                />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//form/group/field[@name='name']"
                position="after"
            >
                <field
                    name='l10n_es_aeat_real_estate_id'
                    context="{'default_partner_id': partner_id}"
                    groups="l10n_es_aeat.group_use_aeat_real_estates"
                    invisible="parent.country_code != 'ES'"
                />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//tree/field[@name='debit']"
                position="before"
            >
                <field
                    name="l10n_es_aeat_real_estate_id"
                    optional='hide'
                    domain="[('company_id', '=', company_id), ('partner_id', '=', partner_id)]"
                    groups="l10n_es_aeat.group_use_aeat_real_estates"
                    column_invisible="parent.country_code != 'ES'"
                />
            </xpath>
        </field>
    </record>
</odoo>
