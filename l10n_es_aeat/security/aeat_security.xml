<odoo noupdate="1">
    <record id="res_groups_privilege_aeat" model="res.groups.privilege">
        <field name="name">Aeat Permissions</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field name="sequence" eval="8" />
    </record>
    <record id="group_account_aeat" model="res.groups">
        <field name="name">AEAT manager</field>
        <field name="privilege_id" ref="res_groups_privilege_aeat" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>
    <record id="group_use_aeat_real_estates" model="res.groups">
        <field name="name">Use AEAT Real Estates</field>
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>
    <record id="l10n_es_aeat_certificate_rule" model="ir.rule">
        <field name="name">AEAT Certificate multi-company</field>
        <field ref="model_l10n_es_aeat_certificate" name="model_id" />
        <field eval="True" name="global" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_es_aeat_real_estate" model="ir.rule">
        <field name="name">AEAT Real Estates multi-company</field>
        <field ref="model_l10n_es_aeat_real_estate" name="model_id" />
        <field eval="True" name="global" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
