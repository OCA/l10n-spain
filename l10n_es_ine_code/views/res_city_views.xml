<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_city_view_form" model="ir.ui.view">
        <field name="name">res.city.form.ine.code</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_location.view_city_form" />
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="ine_code_id" />
            </field>
        </field>
    </record>

    <record id="res_city_view_tree" model="ir.ui.view">
        <field name="name">res.city.tree.ine.code</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_location.view_city_tree_inherit" />
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="ine_code_id" optional="hide" />
            </field>
        </field>
    </record>

</odoo>
