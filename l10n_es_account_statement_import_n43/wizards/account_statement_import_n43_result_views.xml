<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_statement_import_n43_result_form" model="ir.ui.view">
        <field name="name">account.statement.import.n43.result.form</field>
        <field name="model">account.statement.import.n43.result</field>
        <field name="arch" type="xml">
            <form string="Possible duplicates">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>
                            Some movements of the file may be duplicates.
                        </strong>
                        <p class="mb-0">
                            The movements marked as duplicates will not be imported.
                            Uncheck the ones that are not duplicates. Movements already
                            imported are marked by default, movements repeated within
                            the file are not.
                        </p>
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0" editable="bottom">
                            <field name="is_duplicate" widget="boolean_toggle" />
                            <field name="date" />
                            <field name="amount" />
                            <field name="payment_ref" />
                            <field name="reason" />
                            <field name="matched_statement_name" string="Statement" />
                            <field name="matched_line_id" string="Matching line" />
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
