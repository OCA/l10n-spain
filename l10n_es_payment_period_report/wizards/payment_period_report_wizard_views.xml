<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_period_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n.es.payment.period.report.wizard.form</field>
        <field name="model">l10n.es.payment.period.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Supplier Payment Period Report">
                <group>
                    <group>
                        <field name="company_id" />
                        <field name="year" />
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                    <group>
                        <field name="method" />
                        <field
                            name="date_start_type"
                            attrs="{'invisible': [('method', '!=', 'normal')]}"
                        />
                        <field
                            name="legal_payment_days"
                            attrs="{'invisible': [('method', '!=', 'normal')]}"
                        />
                        <field name="currency_id" invisible="1" />
                        <field name="computed_method" invisible="1" />
                    </group>
                </group>
                <div attrs="{'invisible': [('computed_method', '!=', 'normal')]}">
                    <group string="Average payment period to suppliers">
                        <group>
                            <field name="average_payment_period" />
                            <field name="paid_operations_ratio" />
                            <field name="pending_operations_ratio" />
                        </group>
                        <group>
                            <field name="total_amount_paid" />
                            <field name="total_amount_pending" />
                        </group>
                    </group>
                    <group string="Payments within legal period">
                        <group>
                            <field name="total_amount_paid_within" />
                            <field name="amount_within_percent" />
                        </group>
                        <group>
                            <field name="invoice_count" />
                            <field name="invoice_count_within" />
                            <field name="invoice_within_percent" />
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <tree>
                            <field name="line_type" />
                            <field name="move_id" />
                            <field name="partner_id" />
                            <field name="date_start" />
                            <field name="payment_date" />
                            <field name="amount" sum="Total" />
                            <field name="days" />
                            <field name="within_legal_period" />
                        </tree>
                    </field>
                </div>
                <group
                    string="Average payment period to suppliers"
                    attrs="{'invisible': [('computed_method', '!=', 'abbreviated')]}"
                >
                    <group>
                        <field name="average_payment_period" />
                        <field name="creditor_opening_balance" />
                        <field name="creditor_closing_balance" />
                        <field name="creditor_average_balance" />
                    </group>
                    <group>
                        <field name="net_purchases" />
                        <field name="external_services" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_compute"
                        string="Compute"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="action_export_xlsx"
                        string="Export XLSX"
                        type="object"
                    />
                    <button
                        name="action_view_lines"
                        string="View Details"
                        type="object"
                        attrs="{'invisible': [('method', '!=', 'normal')]}"
                    />
                    <button special="cancel" string="Close" />
                </footer>
            </form>
        </field>
    </record>

    <record id="payment_period_report_line_tree" model="ir.ui.view">
        <field name="name">l10n.es.payment.period.report.line.tree</field>
        <field name="model">l10n.es.payment.period.report.line</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0">
                <field name="line_type" />
                <field name="move_id" />
                <field name="partner_id" />
                <field name="invoice_date" />
                <field name="accounting_date" />
                <field name="date_start" />
                <field name="payment_date" />
                <field name="payment_move_id" optional="hide" />
                <field name="amount" sum="Total" />
                <field name="days" />
                <field name="within_legal_period" />
            </tree>
        </field>
    </record>

    <record id="payment_period_report_line_form" model="ir.ui.view">
        <field name="name">l10n.es.payment.period.report.line.form</field>
        <field name="model">l10n.es.payment.period.report.line</field>
        <field name="arch" type="xml">
            <form
                string="Supplier Payment Period Detail"
                create="0"
                edit="0"
                delete="0"
            >
                <group>
                    <group>
                        <field name="line_type" />
                        <field name="move_id" />
                        <field name="partner_id" />
                        <field name="payment_move_id" />
                        <field name="amount" />
                    </group>
                    <group>
                        <field name="invoice_date" />
                        <field name="accounting_date" />
                        <field name="date_start" />
                        <field name="payment_date" />
                        <field name="days" />
                        <field name="within_legal_period" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="payment_period_report_line_search" model="ir.ui.view">
        <field name="name">l10n.es.payment.period.report.line.search</field>
        <field name="model">l10n.es.payment.period.report.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id" />
                <field name="partner_id" />
                <filter
                    name="paid"
                    string="Paid"
                    domain="[('line_type', '=', 'paid')]"
                />
                <filter
                    name="pending"
                    string="Pending payment"
                    domain="[('line_type', '=', 'pending')]"
                />
                <separator />
                <filter
                    name="out_of_legal_period"
                    string="Out of legal period"
                    domain="[('within_legal_period', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_line_type"
                        string="Type"
                        context="{'group_by': 'line_type'}"
                    />
                    <filter
                        name="group_by_partner"
                        string="Supplier"
                        context="{'group_by': 'partner_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="payment_period_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Supplier Payment Period Report</field>
        <field name="res_model">l10n.es.payment.period.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="payment_period_report_menu"
        name="Supplier Payment Period"
        parent="account_financial_report.menu_oca_reports"
        action="payment_period_report_wizard_action"
        groups="account.group_account_readonly"
        sequence="70"
    />
</odoo>
