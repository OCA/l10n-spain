    <record id="view_move_form_inherit_facturae_special_payment" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_es_facturae.view_move_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='facturae']/group" position="inside">
                <separator string="Literal Legals" />
                <field name="literal_legal_ids">
                    <tree>
                        <field name="sequence" widget="handle" />
                        <field name="description" />
                    </tree>

                    <form string="Legal Literal">
                        <group>
                            <field
                                name="description"
                                string="Description"
                                placeholder="Enter the legal literal..."
                                nolabel="0"
                                widget="text"
                            />
                            <field
                                name="description_length"
                                string="Characters Used"
                                readonly="1"
                            />
                        </group>

                        <separator string="Notes" />
                        <p class="oe_edit_only" style="color: #888;">
                            ⚠ The description cannot be longer than <b
                            >250 characters</b> per legal reference.
                            If you enter a longer text, it will be <b
                            >automatically split</b> into multiple legal references of 250 characters each.
                        </p>
                    </form>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
