<odoo noupdate="0">
    <!-- EN 16931:2026 / SPFE Lista L4 Category N (National VAT regimes: RE / Group) -->
    <record id="tax_categ_n" model="unece.code.list">
        <field name="type">tax_categ</field>
        <field name="code">N</field>
        <field name="name">National VAT regimes (Equivalence Surcharge / Group)</field>
        <field name="description">
            Regímenes nacionales de IVA (régimen especial de grupo de entidades, nivel
            avanzado, y régimen especial del recargo de equivalencia).
        </field>
    </record>

    <!-- UNECE 5153 WTH Withholding tax type if not present -->
    <record id="tax_type_wth" model="unece.code.list">
        <field name="type">tax_type</field>
        <field name="code">WTH</field>
        <field name="name">Withholding tax</field>
        <field name="description">Retención practicada en factura (SPFE).</field>
    </record>

    <!-- Spanish VATEX-ES codes defined in SPFE Anexo I / Reglas de Negocio -->
    <record id="tax_vatex_es_iva20" model="unece.code.list">
        <field name="type">tax_vatex</field>
        <field name="code">VATEX-ES-IVA20</field>
        <field name="name">Exenta por el artículo 20 LIVA</field>
        <field
            name="description"
        >Exención en operaciones interiores (Art. 20 LIVA).</field>
    </record>
    <record id="tax_vatex_es_iva21" model="unece.code.list">
