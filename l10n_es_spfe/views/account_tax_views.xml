<odoo>
    <record id="view_tax_spfe_form" model="ir.ui.view">
        <field name="name">account.tax.spfe.form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="spfe" string="SPFE">
                    <group>
                        <group>
                            <field name="spfe_registration_key_id" />
                            <field name="spfe_is_surcharge" />
                        </group>
                        <group>
                            <field name="spfe_is_withholding" />
                            <field
                                name="spfe_withholding_type"
                                invisible="not spfe_is_withholding"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
