<odoo>
    <record id="view_account_journal_spfe_form" model="ir.ui.view">
        <field name="name">account.journal.spfe.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="l10n_es_aeat.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_aeat']/group/group[1]" position="inside">
                <field
                    name="spfe_enabled"
                    invisible="type not in ['sale', 'purchase']"
                />
            </xpath>
        </field>
    </record>
</odoo>
