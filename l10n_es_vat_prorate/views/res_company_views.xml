<odoo>
    <record id="res_company_form_view" model="ir.ui.view">
        <field name="name">res.company.form (in l10n_es_vat_prorate)</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page
                    name="vat_prorate"
                    string="VAT Prorate"
                    invisible="not with_vat_prorate"
                >
                    <field name="vat_prorate_ids" />
                </page>
            </notebook>
            <xpath expr="//field[@id='company_currency']" position="after">
                <field name="with_vat_prorate" />
            </xpath>
        </field>
    </record>
</odoo>
