<odoo>
    <record
        id="view_l10n_es_aeat_mod390_report_form_inherit_prorate"
        model="ir.ui.view"
    >
        <field name="name">l10n_es.aeat.mod390.report.form</field>
        <field name="model">l10n.es.aeat.mod390.report</field>
        <field
            name="inherit_id"
            ref="l10n_es_aeat_mod390.view_l10n_es_aeat_mod390_report_form"
        />
        <field name="arch" type="xml">
            <field name="casilla_98" position="before">
                <field
                    name="casilla_522"
                    widget="monetary"
                    nolabel="1"
                    options="{'currency_field': 'currency_id'}"
                    invisible="not with_vat_prorate or period_type != '0A'"
                    readonly="state == 'done'"
                />
                <label for="casilla_522" />
            </field>
            <field name="statement_type" position="after">
                <field
                    name="vat_prorate_percent"
                    invisible="not with_vat_prorate"
                    required="with_vat_prorate or period_type == '0A'"
                    readonly="state != 'draft'"
                />
            </field>
        </field>
    </record>
</odoo>
